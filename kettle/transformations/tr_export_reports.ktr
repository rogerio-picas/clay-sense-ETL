  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NeonDB Cloud Database</connection>
    <sql>SELECT 
    bc.batch_id AS "ID Lote",
    kf.kiln_id AS "ID Forno",
    
    -- Métricas de Produção
    p.total_qty AS "Peças Carregadas",
    (p.total_qty - p.broken_pieces) AS "Peças Aprovadas",
    p.broken_pieces AS "Peças Partidas",
    ROUND(((p.broken_pieces::NUMERIC / NULLIF(p.total_qty, 0)) * 100), 2) AS "Taxa Quebras (%)",
    
    -- Telemetria da Cozedura
    kf.firing_duration_hours AS "Duração (h)",
    kf.max_temp_recorded AS "Temp Máx (°C)",
    ROUND((kf.max_temp_recorded / NULLIF(kf.firing_duration_hours, 0))::NUMERIC, 2) AS "Ritmo Subida (°C/h)",
    bc.gas_consumed_m3 AS "Gás Consumido (m3)",
    bc.total_kwh_consumed AS "Consumo (kWh)",
    
    -- Custos e Tarifas
    bc.market_kwh_price AS "Tarifa (kWh)",
    bc.total_energy_cost AS "Custo Total",
    bc.energy_cost_per_piece AS "Custo Energético/Peça",
    
    -- Campos de Controlo para o Filtro de Anomalias
    kf.firing_anomaly AS "Anomalia de Chama",
    kf.temp_anomaly AS "Anomalia de Temperatura",
    kf.rate_anomaly AS "Picos de Temperatura",
    
    -- Data dos Registos formatada (sem frações de segundo)
    to_char(bc.calculated_at, 'YYYY-MM-DD HH24:MI:SS') AS "Data de Registo"

FROM batch_cost bc
LEFT JOIN production p ON bc.batch_id = p.batch_id
LEFT JOIN firing_batch fb ON bc.batch_id = fb.batch_id
LEFT JOIN kiln_firing kf ON fb.firing_id = kf.firing_id

-- Filtro para exportar estritamente os registos do dia corrente
WHERE bc.calculated_at >= CURRENT_DATE 
  AND bc.calculated_at &lt; CURRENT_DATE + INTERVAL '1 day'

ORDER BY bc.batch_id DESC;</sql>
