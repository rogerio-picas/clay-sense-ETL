  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Métricas de Produção e Quebras
var v_total_qty = (typeof total_qty !== 'undefined' &amp;&amp; total_qty != null) ? Number(total_qty) : 0;
var v_broken = (typeof broken_pieces !== 'undefined' &amp;&amp; broken_pieces != null) ? Number(broken_pieces) : 0;
var approved_pieces = Math.max(0, v_total_qty - v_broken);
var defect_rate_pct = v_total_qty > 0 ? Number(((v_broken / v_total_qty) * 100.0).toFixed(2)) : 0.0;

// 2. Telemetria do Forno (JSON)
var v_gas_m3 = (typeof gas_consumed_m3 !== 'undefined' &amp;&amp; gas_consumed_m3 != null) ? Number(gas_consumed_m3) : 0.0;
var v_duration = (typeof firing_duration_hours !== 'undefined' &amp;&amp; firing_duration_hours != null) ? Number(firing_duration_hours) : 0.0;
var v_max_temp = (typeof max_temp_recorded !== 'undefined' &amp;&amp; max_temp_recorded != null) ? Number(max_temp_recorded) : 0.0;

// 3. Parâmetros Oficiais da REN (XML) com conversão de MWh para kWh
var raw_price = (typeof market_price_eur_kwh !== 'undefined' &amp;&amp; market_price_eur_kwh != null) ? Number(market_price_eur_kwh) : 35.0;

// Se o valor for >= 1.0 (ex: 350.0 €/MWh), converte para €/kWh dividindo por 1000 (0.3500 €/kWh)
var v_kwh_price = raw_price >= 1.0 ? (raw_price / 1000.0) : raw_price;
var market_kwh_price = Number(v_kwh_price.toFixed(4));

var v_pcs = (typeof calorific_value_pcs !== 'undefined' &amp;&amp; calorific_value_pcs != null) ? Number(calorific_value_pcs) : 10.82;
var v_tax_pct = (typeof network_access_tax_pct !== 'undefined' &amp;&amp; network_access_tax_pct != null) ? Number(network_access_tax_pct) : 0.055;
var v_carbon_tax = (typeof carbon_tax_eur_m3 !== 'undefined' &amp;&amp; carbon_tax_eur_m3 != null) ? Number(carbon_tax_eur_m3) : 0.038;

// 4. Cálculos de Consumo e Custos de Gás Natural
// Conversão física: volume de gás para energia térmica equivalente (kWh)
var total_kwh_consumed = Number((v_gas_m3 * v_pcs).toFixed(2));

// Custo total: Energia faturada com taxa de acesso à rede + Taxa ambiental de emissão
var base_energy_cost = total_kwh_consumed * market_kwh_price * (1 + v_tax_pct);
var total_carbon_cost = v_gas_m3 * v_carbon_tax;
var total_energy_cost = Number((base_energy_cost + total_carbon_cost).toFixed(2));

// Custo energético unitário por peça carregada
var energy_cost_per_piece = v_total_qty > 0 ? Number((total_energy_cost / v_total_qty).toFixed(4)) : 0.0;

// 5. Anomalias Térmicas e Ritmo do Forno
var temp_increase_rate = (v_duration > 0 &amp;&amp; !isNaN(v_max_temp)) ? Number((v_max_temp / v_duration).toFixed(2)) : 0.0;
var v_limit_temp = (typeof max_temperature !== 'undefined' &amp;&amp; max_temperature != null) ? Number(max_temperature) : 1050.0;
var v_limit_rate = (typeof max_tax_temp_increase !== 'undefined' &amp;&amp; max_tax_temp_increase != null) ? Number(max_tax_temp_increase) : 150.0;
var temp_anomaly = (v_max_temp > v_limit_temp);
var rate_anomaly = (temp_increase_rate > v_limit_rate);
var firing_anomaly = (temp_anomaly || rate_anomaly);

// 6. Garantir variáveis de saída para a tabela batch_cost
var final_batch_id = (typeof batch_id !== 'undefined' &amp;&amp; batch_id != null) ? batch_id : null;
var final_gas_consumed_m3 = v_gas_m3;</jsScript_script>
      </jsScript>
    </jsScripts>
